#index.html
<!DOCTYPE html>
<html>
<head>
    <title>Electricity Bill Calculator</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<h1>Electricity Bill Calculator</h1>

<label>Enter Units Consumed:</label>
<input type="number" id="units" placeholder="Enter units">
<button onclick="calculateBill()">Calculate Bill</button>
<h2 id="result"></h2>
<script src="script.js"></script>
</body>
</html>
#style.css
body {
    font-family: Arial, sans-serif;
    margin: 40px;
}

input {
    padding: 8px;
    margin: 10px;
}

button {
    padding: 8px 15px;
    margin-left: 10px;
}

{
    margin-top: 20px;
}
#script.js
unction calculateBill() {

    let units = Number(document.getElementById("units").value);
    let bill = 0;

    if (units <= 100) {
        bill = units * 2;
    }
    else if (units <= 200) {
        bill = (100 * 2) + ((units - 100) * 3);
    }
    else if (units <= 500) {
        bill = (100 * 2) + (100 * 3) + ((units - 200) * 5);
    }
    else {
        bill = (100 * 2) + (100 * 3) + (300 * 5)
            + ((units - 500) * 7);
    }
    document.getElementById("result").innerHTML =
        "Total Electricity Bill = Rs." + bill;
}
